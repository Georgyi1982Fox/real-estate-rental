# Настройки для docker compose (TASK-039).
# Скопируйте в .env и заполните:  copy .env.example .env  (Windows)  /  cp .env.example .env
# Файл .env не попадает в Git — ключи и токены храните только в нём.

# --- База данных (контейнер db) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=придумайте-пароль
POSTGRES_DB=bina
# Порт базы на вашем компьютере (для отладки и переноса данных); 5433 занят старым bina-db
DB_PORT=5434

# --- API ---
# Порт на компьютере: туннель Cloudflare и npm run dev ходят на 127.0.0.1:8000
API_PORT=8000
API_CORS_ORIGINS=https://georgyi1982fox.github.io

# --- Telegram-бот (токен от @BotFather) ---
BOT_TOKEN=
# Mini App: кнопка меню бота и кнопка «Открыть» в уведомлениях
BOT_MINI_APP_URL=https://bina.test-realtybot.ru

# --- Подписка Premium (звёзды Telegram). Пусто — 250 звёзд за 30 дней ---
PREMIUM_PRICE_STARS=
PREMIUM_DAYS=
# Недельный пропуск (TASK-084). Пусто — 100 звёзд за 7 дней; PREMIUM_WEEK_PRICE_STARS=0 — без него
PREMIUM_WEEK_PRICE_STARS=
PREMIUM_WEEK_DAYS=
# «🔥 Топ» для объявления хозяина на 7 дней (TASK-097). Пусто — 150 звёзд
PROMOTION_PRICE_STARS=
# Кабинет агентства (TASK-100). Пусто — 10 бесплатно; пакеты id:объявлений:звёзд на 30 дней;
# Premium-объявление (раз в сутки поднимается) — 100 звёзд на 30 дней
AGENCY_FREE_LISTINGS=
AGENCY_PLANS=
BUMP_PRICE_STARS=
# Режим тестирования: 1 (по умолчанию) — все платные функции бесплатно для всех;
# 0 — только для оплативших Premium (включить перед запуском для людей)
PREMIUM_FOR_ALL=1

# Ваш Telegram ID (узнать: бот @userinfobot) — для команды /admin: жалобы и статистика
ADMIN_TELEGRAM_IDS=

# Защита от перегрузки (TASK-019). Пусто — по умолчанию: 120 запросов в минуту с IP,
# 20 «тяжёлых» (PDF, AI, оплата), в боте 20 сообщений за 10 секунд. 0 — без ограничения
API_RATE_LIMIT=
API_HEAVY_RATE_LIMIT=
BOT_RATE_LIMIT=

# --- Парсер: каждые N часов, до M объявлений с каждого сайта (дальше известных не идёт) ---
SCRAPE_INTERVAL_HOURS=1
# Задержка уведомлений бесплатного тарифа, часов (Premium — сразу)
FREE_ALERT_DELAY_HOURS=3
SCRAPE_LIMIT=500
# Города (TASK-079): tbilisi, batumi через запятую. Пусто — оба
SCRAPE_CITIES=
# Адрес поиска Батуми на myhome.ge (с {page}). Пусто — адрес по умолчанию
MYHOME_SEARCH_PATH_BATUMI=
# Посуточная аренда на myhome.ge (TASK-092), с {page}. Пусто — по умолчанию, «-» — не собирать
MYHOME_DAILY_SEARCH_PATH=
MYHOME_DAILY_SEARCH_PATH_BATUMI=

# --- AI-перевод (AITUNNEL). Пусто — парсер работает без перевода ---
LLM_API_KEY=
# Пусто — qwen3-max. Названия: https://aitunnel.ru/models
LLM_MODEL=
# Сколько объявлений AI переводит/проверяет одновременно (по умолчанию 5)
# LLM_CONCURRENCY=5
# LLM_BASE_URL=https://api.aitunnel.ru/v1
# Умный поиск (TASK-012): по умолчанию тот же ключ и адрес, модель text-embedding-3-small.
# Отдельный ключ/адрес/модель — только если нужно:
# EMBEDDINGS_API_KEY=
# EMBEDDINGS_BASE_URL=
# EMBEDDINGS_MODEL=text-embedding-3-small
# Голосовые в умном поиске (распознавание речи). Пусто — тот же ключ и адрес, модель whisper-1
# STT_API_KEY=
# STT_BASE_URL=
# STT_MODEL=whisper-1
# AI-анализ фото (TASK-114): объявлений за запуск (0 — выключено), модель с картинками
# PHOTO_ANALYSIS_LIMIT=50
# PHOTO_MODEL=gpt-4o-mini

# --- Бэкапы базы в папку backups/ (TASK-044). Пусто — раз в 24 ч, хранить 14 дней ---
BACKUP_EVERY_HOURS=
BACKUP_KEEP_DAYS=

# --- Telegram-каналы как источник (TASK-091, нужен LLM_API_KEY). Пусто — список по умолчанию ---
TELEGRAM_CHANNELS=
TELEGRAM_MAX_AGE_DAYS=

# --- AI-помощник (TASK-095): запросов к AI на пользователя в день. Пусто — 30 ---
ASSISTANT_DAILY_LIMIT=
